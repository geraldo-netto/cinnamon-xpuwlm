{
  "name": "cinnamon-xpuwlm",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Cinnamon XPU Workload Manager applet for TPU, NPU, and GPU accelerators",
  "scripts": {
    "lint": "eslint files scripts tests",
    "test:syntax": "node scripts/validate-artifacts.js",
    "check:workloads": "node scripts/check-workload-manifests.js",
    "check:plugin": "node scripts/package-workload-plugin.js validate",
    "generate:pot": "node scripts/generate-pot.js",
    "generate:contract": "node scripts/generate-snapshot-contract.js",
    "check:contract": "node scripts/generate-snapshot-contract.js --check",
    "package": "node scripts/package-applet.js pack",
    "package:spice": "node scripts/package-applet.js spice",
    "package:verify": "node scripts/package-applet.js verify",
    "package:plugin": "node scripts/package-workload-plugin.js pack",
    "test:contract": "node --test tests/contract/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:regression": "node --test tests/regression/*.test.js",
    "test:fuzz": "node --test tests/fuzz/*.test.js",
    "test:visual": "node --test tests/visual/*.test.js",
    "test:cjs": "\"${XPUWLM_CJS:-cjs}\" tests/cjs/production-smoke.js files/cinnamon-xpuwlm@geraldo-netto/*.js files/cinnamon-xpuwlm@geraldo-netto/lib/*.js",
    "test:mutation-target": "XPUWLM_MUTATION_RUN=1 node --test --test-concurrency=2 tests/unit/*.test.js tests/integration/*.test.js tests/regression/*.test.js tests/contract/*.test.js",
    "test:mutation:workflow-validation-target": "node --test tests/regression/workflow-validation-boundaries-regression.test.js tests/fuzz/caption-export.fuzz.test.js",
    "test:mutation:workflow-duration": "stryker run stryker.workflow-validation.config.json --mutate='files/cinnamon-xpuwlm@geraldo-netto/lib/media-transcription.js:108-115'",
    "test:mutation:workflow-cues": "stryker run stryker.workflow-validation.config.json --mutate='files/cinnamon-xpuwlm@geraldo-netto/lib/caption-export.js:56-68'",
    "test:mutation:workflow-image-file": "stryker run stryker.workflow-validation.config.json --mutate='files/cinnamon-xpuwlm@geraldo-netto/lib/screenshot-assistant.js:44-48'",
    "test:mutation:workflow-capture-time": "stryker run stryker.workflow-validation.config.json --mutate='files/cinnamon-xpuwlm@geraldo-netto/lib/screenshot-assistant.js:56-60'",
    "test:mutation:workflow-validation": "npm run test:mutation:workflow-duration && npm run test:mutation:workflow-cues && npm run test:mutation:workflow-image-file && npm run test:mutation:workflow-capture-time",
    "test:mutation:artifact-validation-target": "node --test tests/unit/validate-artifacts.test.js",
    "test:mutation:snapshot-contract-target": "node --test tests/unit/generate-snapshot-contract.test.js tests/contract/snapshot-validator-schema-parity-contract.test.js",
    "test:mutation:artifact-validation": "stryker run stryker.artifact-validation.config.json",
    "test:mutation:snapshot-contract": "stryker run stryker.snapshot-contract.config.json",
    "test:mutation:script-tools": "npm run test:mutation:artifact-validation && npm run test:mutation:snapshot-contract",
    "test:mutation:string-contract-target": "node --test tests/unit/workload-manifest.test.js tests/unit/workload-manifest-boundaries.test.js tests/fuzz/workload-manifest.fuzz.test.js",
    "test:mutation:string-contract": "stryker run stryker.string-contract.config.json && XPUWLM_REQUIRE_STRING_MUTATION_REPORT=1 node --test tests/contract/string-literal-mutation-report-contract.test.js",
    "test:mutation:popup-placement-target": "node --test tests/unit/popup-placement.test.js tests/unit/cinnamon-popup-adapter.test.js tests/integration/applet.test.js tests/fuzz/popup-placement.fuzz.test.js",
    "test:mutation:popup-finite-number": "stryker run stryker.popup-placement.config.json --mutate='files/cinnamon-xpuwlm@geraldo-netto/lib/popup-placement.js:6-8'",
    "test:mutation:popup-positive-finite": "stryker run stryker.popup-placement.config.json --mutate='files/cinnamon-xpuwlm@geraldo-netto/lib/popup-placement.js:10-12'",
    "test:mutation:popup-valid-work-area": "stryker run stryker.popup-placement.config.json --mutate='files/cinnamon-xpuwlm@geraldo-netto/lib/popup-placement.js:14-18'",
    "test:mutation:popup-centered-position": "stryker run stryker.popup-placement.config.json --mutate='files/cinnamon-xpuwlm@geraldo-netto/lib/popup-placement.js:20-31'",
    "test:mutation:popup-workspace-area": "stryker run stryker.popup-placement.config.json --mutate='files/cinnamon-xpuwlm@geraldo-netto/lib/cinnamon-popup-adapter.js:5-17'",
    "test:mutation:popup-monitor-area": "stryker run stryker.popup-placement.config.json --mutate='files/cinnamon-xpuwlm@geraldo-netto/lib/cinnamon-popup-adapter.js:19-26'",
    "test:mutation:popup-menu-class": "stryker run stryker.popup-placement.config.json --mutate='files/cinnamon-xpuwlm@geraldo-netto/lib/cinnamon-popup-adapter.js:28-49'",
    "test:mutation:popup-menu-factory": "stryker run stryker.popup-placement.config.json --mutate='files/cinnamon-xpuwlm@geraldo-netto/lib/cinnamon-popup-adapter.js:51-61'",
    "test:mutation:popup-presentation": "stryker run stryker.popup-placement.config.json --mutate='files/cinnamon-xpuwlm@geraldo-netto/applet.js:307-334'",
    "test:mutation:popup-placement": "npm run test:mutation:popup-finite-number && npm run test:mutation:popup-positive-finite && npm run test:mutation:popup-valid-work-area && npm run test:mutation:popup-centered-position && npm run test:mutation:popup-workspace-area && npm run test:mutation:popup-monitor-area && npm run test:mutation:popup-menu-class && npm run test:mutation:popup-menu-factory && npm run test:mutation:popup-presentation",
    "test:coverage-target": "node --test tests/unit/*.test.js tests/integration/*.test.js tests/regression/*.test.js tests/contract/*.test.js",
    "test:coverage": "c8 --clean --reporter=text --reporter=json --reports-dir=coverage --all --include='files/cinnamon-xpuwlm@geraldo-netto/applet.js' --include='files/cinnamon-xpuwlm@geraldo-netto/lib/**/*.js' --include='scripts/check-workload-manifests.js' --include='scripts/generate-pot.js' --include='scripts/package-applet.js' --include='scripts/package-workload-plugin.js' --include='scripts/validate-artifacts.js' --check-coverage --lines=80 --branches=80 --functions=80 --statements=80 npm run test:coverage-target && node scripts/check-per-function-coverage.js",
    "test:mutation": "stryker run && npm run test:mutation:string-contract",
    "test:mutation:full": "stryker run stryker.full.config.cjs && XPUWLM_REQUIRE_FULL_MUTATION_REPORT=1 node --test tests/contract/full-mutation-report-contract.test.js",
    "test:ci": "npm run lint && npm run test:syntax && npm run check:contract && npm run check:workloads && npm run test:coverage && npm run test:fuzz && npm run test:visual",
    "test:local": "XPUWLM_SKIP_HOST_GATES=1 npm test",
    "test": "npm run lint && npm run test:syntax && npm run check:contract && npm run check:workloads && npm run test:coverage && npm run test:fuzz && npm run test:visual && npm run test:mutation"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "9.6.1",
    "ajv": "8.18.0",
    "c8": "12.0.0",
    "eslint": "10.8.1"
  },
  "overrides": {
    "qs": "6.15.3"
  },
  "engines": {
    "node": ">=24"
  }
}
