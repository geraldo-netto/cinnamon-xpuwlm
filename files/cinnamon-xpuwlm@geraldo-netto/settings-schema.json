{
  "layout": {
    "type": "layout",
    "pages": [
      "general-page",
      "runtime-page"
    ],
    "general-page": {
      "type": "page",
      "title": "General",
      "sections": [
        "panel-section",
        "polling-section"
      ]
    },
    "runtime-page": {
      "type": "page",
      "title": "Runtime integration",
      "sections": [
        "runtime-section"
      ]
    },
    "panel-section": {
      "type": "section",
      "title": "Panel",
      "keys": [
        "show-panel-label"
      ]
    },
    "polling-section": {
      "type": "section",
      "title": "Monitoring",
      "keys": [
        "refresh-interval"
      ]
    },
    "runtime-section": {
      "type": "section",
      "title": "Workload runtime",
      "keys": [
        "runtime-state-path",
        "runtime-help"
      ]
    }
  },
  "show-panel-label": {
    "type": "switch",
    "default": false,
    "description": "Show XPU status beside the panel icon"
  },
  "refresh-interval": {
    "type": "scale",
    "default": 1,
    "min": 1,
    "max": 60,
    "step": 1,
    "units": "seconds",
    "description": "Refresh interval"
  },
  "runtime-state-path": {
    "type": "entry",
    "default": "~/.local/state/xpu-workload-manager/state.json",
    "description": "Runtime snapshot file",
    "tooltip": "A trusted local service may atomically publish the versioned JSON contract documented by this applet."
  },
  "runtime-help": {
    "type": "label",
    "description": "The panel reads this file to show status. Everything else happens in the XPU Workload Manager client, which the menu opens."
  }
}
