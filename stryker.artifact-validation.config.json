{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm run test:mutation:artifact-validation-target"
  },
  "coverageAnalysis": "off",
  "incremental": false,
  "mutate": [
    "scripts/validate-artifacts.js"
  ],
  "mutator": {
    "excludedMutations": [
      "StringLiteral"
    ]
  },
  "reporters": [
    "clear-text",
    "progress"
  ],
  "thresholds": {
    "high": 80,
    "low": 80,
    "break": 80
  },
  "concurrency": 4,
  "timeoutMS": 10000,
  "timeoutFactor": 2.5,
  "cleanTempDir": "always"
}
