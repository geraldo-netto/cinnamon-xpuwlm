{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm run test:mutation-target"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "files/cinnamon-tpuwm@geraldo-netto/applet.js",
    "files/cinnamon-tpuwm@geraldo-netto/lib/**/*.js"
  ],
  "mutator": {
    "excludedMutations": ["StringLiteral"]
  },
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "mutation-report/index.html"
  },
  "thresholds": {
    "high": 80,
    "low": 80,
    "break": 80
  },
  "concurrency": 2,
  "timeoutMS": 10000,
  "timeoutFactor": 2.5,
  "tempDirName": ".stryker-tmp"
}
